<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Zuul.ico</ApplicationIcon>
    <AssemblyTitle>Zuul</AssemblyTitle>
    <Product>Zuul</Product>
    <Description>Type a thing, then do it.</Description>
    <!-- Release builds get the tag's version from CI; anything else is a dev build that never updates. -->
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <EmbeddedResource Include="DefaultThemes.json" />
    <InternalsVisibleTo Include="Zuul.Tests" />
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zuul.Core\Zuul.Core.csproj" />
  </ItemGroup>
</Project>
