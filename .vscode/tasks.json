{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/src/Zuul/Zuul.csproj"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/Zuul.slnx"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish portable Windows app",
      "type": "process",
      "command": "dotnet",
      "args": ["publish", "${workspaceFolder}/src/Zuul/Zuul.csproj", "-c", "Release", "-r", "win-x64", "--self-contained", "true", "-o", "${workspaceFolder}/artifacts/Zuul"],
      "problemMatcher": "$msCompile"
    }
  ]
}
